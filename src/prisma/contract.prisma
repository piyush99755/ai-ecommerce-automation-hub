// use prisma-next

enum OrderStatus {
  PENDING
  PROCESSING
  ON_HOLD
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
}

model Product {
  id                String            @id @default(dbgenerated("gen_random_uuid()"))
  name              String
  slug              String            @unique
  description       String
  priceCents        Int
  stock             Int
  lowStockThreshold Int               @default(5)
  category          String
  imageUrl          String?
  orderItems        OrderItem[]
  createdAt         TimestamptzString @default(now())
  updatedAt         temporal.updatedAtString()

  @@index([category])
}

model Customer {
  id        String            @id @default(dbgenerated("gen_random_uuid()"))
  name      String
  email     String            @unique
  phone     String?
  orders    Order[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Order {
  id                      String            @id @default(dbgenerated("gen_random_uuid()"))
  customer                Customer          @relation(fields: [customerId], references: [id])
  customerId              String
  status                  OrderStatus       @default(PENDING)
  statusReason            String?
  paymentStatus           PaymentStatus     @default(PENDING)
  subtotalCents           Int
  totalCents              Int
  stripeCheckoutSessionId String?           @unique
  stripePaymentIntentId   String?
  trackingNumber          String?
  carrier                 String?
  shippedAt               TimestamptzString?
  deliveredAt             TimestamptzString?
  items                   OrderItem[]
  createdAt               TimestamptzString @default(now())
  updatedAt               temporal.updatedAtString()
}

model OrderItem {
  id             String  @id @default(dbgenerated("gen_random_uuid()"))
  order          Order   @relation(fields: [orderId], references: [id])
  orderId        String
  product        Product @relation(fields: [productId], references: [id])
  productId      String
  quantity       Int
  unitPriceCents Int
}

model StripeEvent {
  id        String            @id
  type      String
  createdAt TimestamptzString @default(now())
}

model OutboxEvent {
  id            String            @id @default(dbgenerated("gen_random_uuid()"))
  eventType     String
  aggregateType String
  aggregateId   String
  payload       Json
  status        OutboxStatus      @default(PENDING)
  attemptCount  Int               @default(0)
  nextAttemptAt TimestamptzString?
  lastAttemptAt TimestamptzString?
  deliveredAt   TimestamptzString?
  lastError     String?
  createdAt     TimestamptzString @default(now())

  @@index([status, nextAttemptAt])
  @@index([aggregateType, aggregateId])
}
