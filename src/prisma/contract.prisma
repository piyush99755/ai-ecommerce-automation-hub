// use prisma-next

enum OrderStatus {
  PENDING
  PROCESSING
  ON_HOLD
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
}

enum AdminRole {
  ADMIN
}

model Admin {
  id                    String                 @id @default(dbgenerated("gen_random_uuid()"))
  email                 String                 @unique
  passwordHash          String
  name                  String
  role                  AdminRole              @default(ADMIN)
  inventoryAdjustments  InventoryAdjustment[]
  outboxRecoveryActions OutboxRecoveryAction[]
  createdAt             TimestamptzString      @default(now())
  updatedAt             temporal.updatedAtString()
}

model Product {
  id                   String                @id @default(dbgenerated("gen_random_uuid()"))
  name                 String
  slug                 String                @unique
  description          String
  priceCents           Int
  stock                Int
  lowStockThreshold    Int                   @default(5)
  category             String
  imageUrl             String?
  orderItems           OrderItem[]
  inventoryAdjustments InventoryAdjustment[]
  createdAt            TimestamptzString     @default(now())
  updatedAt            temporal.updatedAtString()

  @@index([category])
}

model Customer {
  id        String            @id @default(dbgenerated("gen_random_uuid()"))
  name      String
  email     String            @unique
  phone     String?
  orders    Order[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Order {
  id                      String            @id @default(dbgenerated("gen_random_uuid()"))
  customer                Customer          @relation(fields: [customerId], references: [id])
  customerId              String
  status                  OrderStatus       @default(PENDING)
  statusReason            String?
  paymentStatus           PaymentStatus     @default(PENDING)
  subtotalCents           Int
  totalCents              Int
  stripeCheckoutSessionId String?           @unique
  stripePaymentIntentId   String?
  trackingNumber          String?
  carrier                 String?
  shippedAt               TimestamptzString?
  deliveredAt             TimestamptzString?
  items                   OrderItem[]
  createdAt               TimestamptzString @default(now())
  updatedAt               temporal.updatedAtString()
}

model OrderItem {
  id             String  @id @default(dbgenerated("gen_random_uuid()"))
  order          Order   @relation(fields: [orderId], references: [id])
  orderId        String
  product        Product @relation(fields: [productId], references: [id])
  productId      String
  quantity       Int
  unitPriceCents Int
}

model InventoryAdjustment {
  id            String            @id @default(dbgenerated("gen_random_uuid()"))
  product       Product           @relation(fields: [productId], references: [id])
  productId     String
  admin         Admin             @relation(fields: [adminId], references: [id])
  adminId       String
  previousStock Int
  newStock      Int
  delta         Int
  reason        String
  createdAt     TimestamptzString @default(now())

  @@index([productId, createdAt])
  @@index([adminId, createdAt])
}

model StripeEvent {
  id        String            @id
  type      String
  createdAt TimestamptzString @default(now())
}

model OutboxEvent {
  id              String                 @id @default(dbgenerated("gen_random_uuid()"))
  eventType       String
  aggregateType   String
  aggregateId     String
  payload         Json
  status          OutboxStatus           @default(PENDING)
  attemptCount    Int                    @default(0)
  nextAttemptAt   TimestamptzString?
  lastAttemptAt   TimestamptzString?
  deliveredAt     TimestamptzString?
  lastError       String?
  recoveryActions OutboxRecoveryAction[]
  createdAt       TimestamptzString      @default(now())

  @@index([status, nextAttemptAt])
  @@index([aggregateType, aggregateId])
}

model OutboxRecoveryAction {
  id                   String            @id @default(dbgenerated("gen_random_uuid()"))
  outboxEvent          OutboxEvent       @relation(fields: [outboxEventId], references: [id])
  outboxEventId        String
  admin                Admin             @relation(fields: [adminId], references: [id])
  adminId              String
  action               String            @default("REQUEUE")
  previousStatus       String
  previousAttemptCount Int
  reason               String
  createdAt            TimestamptzString @default(now())

  @@index([outboxEventId, createdAt])
  @@index([adminId, createdAt])
}

model ConsumerEvent {
  id           String            @id @default(dbgenerated("gen_random_uuid()"))
  consumerId   String
  eventId      String
  status       String            @default("PROCESSING")
  attemptCount Int               @default(1)
  claimedAt    TimestamptzString @default(now())
  completedAt  TimestamptzString?
  lastError    String?
  createdAt    TimestamptzString @default(now())

  @@unique([consumerId, eventId])
  @@index([status, claimedAt])
}
