# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@pooled-host/database?sslmode=require"
DIRECT_URL="postgresql://user:password@direct-host/database?sslmode=require"

# Server-only n8n webhook URL for order creation events (DO NOT prefix with NEXT_PUBLIC_)
N8N_ORDER_CREATED_WEBHOOK_URL="http://localhost:5678/webhook-test/order-created"
